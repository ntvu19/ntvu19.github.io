{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@content/*": ["./src/content/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    ".astro/types.d.ts",
    "astro.config.mjs",
    "eslint.config.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
